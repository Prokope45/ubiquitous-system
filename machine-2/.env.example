# Tailscale
TS_AUTHKEY=

# MARK: Openwebui
OPEN_WEBUI_DOMAIN=openwebui.domain.com
OPEN_WEBUI_OAUTH_CLIENT_ID=
OPEN_WEBUI_OAUTH_CLIENT_SECRET=
OPEN_WEBUI_OAUTH_PROVIDER_URL=https://id.domain.com/.well-known/openid-configuration
OPEN_WEBUI_OAUTH_PROVIDER_NAME=PocketID

# MARK: Caddy
CLOUD_FLARE_API_KEY_CADDY=

# MARK: Ollama
# Tailscale IP of THIS docker host (run `tailscale ip -4` on the host to get it)
# Ollama's port is bound only to this address.
HOST_IP=100.x.x.x

# MARK: Hermes Agent
# Secret Open WebUI (on the Cloud machine) will present when calling
# Hermes's OpenAI-compatible API. Generate with: openssl rand -hex 32
HERMES_API_SERVER_KEY=your-hermes-api-key

# NOTE: GPU passthrough requires the NVIDIA Container Toolkit installed on
# this host. Verify with:
#   docker run --rm --gpus all nvidia/cuda:12.4.1-base-ubuntu22.04 nvidia-smi

# Portainer
PORTAINER_AGENT_SECRET=<same value you generated for Blackstone's .env>
