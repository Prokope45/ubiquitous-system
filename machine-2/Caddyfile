{
    acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

ollama.prokope.io {
	# Ollama validates the Host header and 403s anything that isn't
    # localhost/127.0.0.1, as DNS-rebinding protection. Caddy forwards the
    # original Host (ollama.prokope.io) by default, which trips that check --
    # rewrite it to what Ollama actually expects.

    reverse_proxy localhost:11434 {
        header_up Host localhost
    }
}

hermes.prokope.io {
	reverse_proxy localhost:8642
}